{
  "name": "playground",
  "build": {
    "context": "..",
    "dockerfile": "./dockerfile"
  },
  "remoteUser": "nishko",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "./features/nushell": {},
    "./features/neovim": {},
    "./features/gh": {},
    "./features/claude": {},
    "./features/codex": {},
    "./features/antigravity": {},
    "./features/node": {},
    "./features/python": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "nu": { "path": "/usr/local/bin/nu" }
        },
        "terminal.integrated.defaultProfile.linux": "nu"
      },
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "Google.google-antigravity"
      ]
    }
  },
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) ${containerWorkspaceFolder}"
}
