{
  "name": "minimal",
  "build": {
    "context": "../..",
    "dockerfile": "../dockerfile"
  },
  "remoteUser": "nishko",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "../features/nushell": {},
    "../features/neovim": {},
    "../features/gh": {}
  },
  "overrideFeatureInstallOrder": [
    "../features/nushell",
    "../features/neovim"
  ],
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) ${containerWorkspaceFolder}"
}
