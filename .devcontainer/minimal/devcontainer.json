{
  "name": "minimal",
  "build": {
    "context": "../..",
    "dockerfile": "../dockerfile"
  },
  "remoteUser": "nishko",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "../features/nushell": {},
    "../features/neovim": {},
    "../features/gh": {},
    "../features/claude": {},
    "../features/codex": {},
    "../features/antigravity": {}
  },
  "overrideFeatureInstallOrder": [
    "../features/nushell",
    "../features/neovim"
  ],
  "customizations": {
    "codespaces": {
      "repositories": {
        "nishkodotco/dotfiles": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "Google.google-antigravity"
      ],
      "settings": {
        "terminal.integrated.profiles.linux": {
          "nu": {
            "path": "/usr/local/bin/nu"
          }
        },
        "terminal.integrated.defaultProfile.linux": "nu"
      }
    }
  },
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) ${containerWorkspaceFolder}"
}
