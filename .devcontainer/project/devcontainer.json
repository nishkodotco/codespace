{
  "name": "project",
  "build": {
    "context": "../..",
    "dockerfile": "../dockerfile"
  },
  "remoteUser": "nishko",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "../features/nushell": {},
    "../features/neovim": {},
    "../features/gh": {},
    "../features/claude": {},
    "../features/codex": {},
    "../features/antigravity": {}
  },
  "overrideFeatureInstallOrder": [
    "../features/nushell",
    "../features/neovim"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "Google.google-antigravity"
      ]
    }
  },
  "postCreateCommand": "sudo chown -R $(id -u):$(id -g) ${containerWorkspaceFolder}"
}
